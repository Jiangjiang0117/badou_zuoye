# 复制为 .env 后填入自己的 Key（.env 不要提交到 git）
# 阿里云百炼：https://bailian.console.aliyun.com/?tab=model#/api-key
SQL_AGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SQL_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SQL_AGENT_MODEL=qwen-plus

# 可选配置
SQL_AGENT_MAX_ROWS=100
SQL_AGENT_MAX_REPAIR=3
SQL_AGENT_QUERY_TIMEOUT=30
SQL_AGENT_TEMPERATURE=0

# 如果使用 OpenAI 官方服务：
# SQL_AGENT_API_KEY=sk-...
# SQL_AGENT_BASE_URL=https://api.openai.com/v1
# SQL_AGENT_MODEL=gpt-4.1-mini
