 # 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会入库。

# ── 博查 Web Search API ──────────────────────────────────────
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search

# ── LLM（DeepSeek / 任意 OpenAI 兼容接口）────────────────────
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 可选覆盖（不填则用 app/config.py 里的默认值）─────────────
# MAX_ROUNDS=3
# FETCH_ENABLED=true
# FETCH_MAX_CONCURRENCY=5
